GEMINI_API_KEY=put_your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
PORT=3000
# Comma-separated list of authorized emails allowed to login or register (e.g. yourname@gmail.com, @company.com)
AUTHORIZED_EMAILS=admin@aistudio.com,demo@aistudio.com,yourname@example.com

# Live Email Delivery via Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Agentic AI Studio <onboarding@resend.dev>

# Optional Alternative: Real Email OTP Delivery via Gmail
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
